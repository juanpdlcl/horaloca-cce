{
  "cleanUrls": true,
  "redirects": [
    { "source": "/cotiza.html", "destination": "/cotiza", "permanent": true },
    { "source": "/admin.html", "destination": "/admin", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
